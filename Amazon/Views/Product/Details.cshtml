@model ProductCardViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="product-details">
    <div class="product-details__image">
        <img src="@Model.ImageUrl" alt="@Model.Name" />
    </div>
    <div class="product-details__content">
        <span class="product-card__category">@Model.Category</span>
        <h1>@Model.Name</h1>
        <div class="product-card__rating" aria-label="Оцінка @Model.Rating з 5">
            <span aria-hidden="true">★★★★★</span>
            <small>@Model.Rating · @Model.ReviewCount відгуків</small>
        </div>
        <p class="product-details__description">@Model.Description</p>
        <div class="product-details__price">
            <strong>@Model.Price.ToString("N0") ₴</strong>
            @if (Model.OldPrice.HasValue)
            {
                <del>@Model.OldPrice.Value.ToString("N0") ₴</del>
            }
        </div>
        <button class="amazon-button amazon-button--primary"
                type="button"
                data-add-to-cart="@Model.Id"
                data-product="@System.Text.Json.JsonSerializer.Serialize(new { id = Model.Id, name = Model.Name, price = Model.Price, imageUrl = Model.ImageUrl, category = Model.Category })">
            🛒 Додати в кошик
        </button>
    </div>
</div>
