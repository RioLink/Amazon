@model ProductCardViewModel

@{
    ViewData["Title"] = Model.Name;
    var hasDiscount = Model.OldPrice.HasValue;
    var discount    = hasDiscount ? (int)Math.Round((1 - (double)Model.Price / (double)Model.OldPrice!.Value) * 100) : 0;
    var saving      = hasDiscount ? Model.OldPrice!.Value - Model.Price : 0;
    var ratingVal   = Model.Rating ?? 0.0;
    var full        = (int)Math.Floor(ratingVal);
    var half        = (ratingVal - full) >= 0.5;
}

<!-- Breadcrumb -->
<nav class="details-breadcrumb" aria-label="Навігація">
    <a asp-controller="Home" asp-action="Index">Головна</a>
    <span>›</span>
    <a asp-controller="Product" asp-action="Index">Товари</a>
    <span>›</span>
    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@Model.CategoryId">@Model.Category</a>
    <span>›</span>
    <span class="details-breadcrumb__current">@Model.Name</span>
</nav>

<div class="product-details">

    <!-- ── Image ── -->
    <div class="product-details__gallery">
        <div class="product-details__image-wrap">
            @if (hasDiscount)
            {
                <span class="product-details__discount-badge">−@discount%</span>
            }
            <img class="product-details__img" src="@Model.ImageUrl" alt="@Model.Name" />
        </div>
    </div>

    <!-- ── Info ── -->
    <div class="product-details__info">

        <span class="product-details__category-chip">@Model.Category</span>
        <h1 class="product-details__title">@Model.Name</h1>

        @if (Model.Rating.HasValue)
        {
            <div class="product-details__stars">
                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= full) { <span class="star star--full">★</span> }
                    else if (i == full + 1 && half) { <span class="star star--half">★</span> }
                    else { <span class="star star--empty">★</span> }
                }
                <span class="product-details__rating-val">@Model.Rating?.ToString("F1")</span>
                @if (Model.ReviewCount.HasValue)
                {
                    <span class="product-details__review-link">(@Model.ReviewCount відгуків)</span>
                }
            </div>
        }

        <div class="product-details__divider"></div>

        <!-- Price -->
        <div class="product-details__price-block">
            <span class="product-details__price-current">@Model.Price.ToString("N0") ₴</span>
            @if (hasDiscount)
            {
                <div class="product-details__price-meta">
                    <span class="product-details__price-old">@Model.OldPrice!.Value.ToString("N0") ₴</span>
                    <span class="product-details__price-saving">Економія: @saving.ToString("N0") ₴</span>
                </div>
            }
        </div>

        <!-- Stock / delivery -->
        <div class="product-details__badges">
            <span class="product-details__stock">✔ В наявності</span>
            <span class="product-details__delivery">🚚 Доставка 2–5 днів</span>
        </div>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="product-details__description">@Model.Description</p>
        }

        <div class="product-details__divider"></div>

        <!-- Qty + Add to cart -->
        <form class="product-details__actions" asp-controller="Cart" asp-action="Add" method="post" id="detailsForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ProductId" value="@Model.Id" />
            <input type="hidden" name="Quantity" id="qtyInput" value="1" />
            <div class="qty-stepper">
                <button class="qty-stepper__btn" type="button" id="qtyMinus" aria-label="Зменшити">−</button>
                <span class="qty-stepper__value" id="qtyValue">1</span>
                <button class="qty-stepper__btn" type="button" id="qtyPlus" aria-label="Збільшити">+</button>
            </div>
            <button class="amazon-button amazon-button--primary product-details__add-btn" type="submit">
                <svg viewBox="0 0 24 24" aria-hidden="true" style="width:20px;flex-shrink:0;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round">
                    <path d="M2.5 3.5h2l2.1 10.2a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 1.9-1.4L21 7H6m3 12a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm10 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z"/>
                </svg>
                Додати в кошик
            </button>
        </form>

        <!-- Trust -->
        <div class="product-details__trust">
            <div class="product-details__trust-item">🔒 Безпечна оплата</div>
            <div class="product-details__trust-item">↩ Повернення 30 днів</div>
            <div class="product-details__trust-item">☎ Підтримка 24/7</div>
        </div>
    </div>
</div>

@* ── Reviews section ── *@
@{
    var reviews = ViewData["Reviews"] as List<Domain.Entities.Review> ?? new();
}
<section class="reviews-section" id="reviews">
    <h2 class="reviews-section__title">
        Відгуки
        @if (reviews.Any())
        {
            <span class="reviews-section__count">(@reviews.Count)</span>
        }
    </h2>

    @if (reviews.Any())
    {
        <div class="reviews-list">
            @foreach (var r in reviews)
            {
                <div class="review-card">
                    <div class="review-card__head">
                        <span class="review-card__author">@r.AuthorName</span>
                        <div class="review-card__stars">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span class="@(i <= r.Stars ? "star star--full" : "star star--empty")">★</span>
                            }
                        </div>
                        <span class="review-card__date">@r.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(r.Body))
                    {
                        <p class="review-card__body">@r.Body</p>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <p class="reviews-section__empty">Відгуків ще немає. Будьте першим!</p>
    }

    @* ── Add review form ── *@
    <div class="review-form-wrap">
        <h3 class="review-form__title">Залишити відгук</h3>
        <form class="review-form" asp-controller="Product" asp-action="AddReview" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@Model.Id" />

            @if (!(User.Identity?.IsAuthenticated == true))
            {
                <div class="review-form__field">
                    <label class="review-form__label">Ваше ім'я</label>
                    <input class="review-form__input" type="text" name="authorName"
                           placeholder="Ім'я або нікнейм" maxlength="60" />
                </div>
            }

            <div class="review-form__field">
                <label class="review-form__label">Оцінка</label>
                <div class="star-picker" id="starPicker">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <button type="button" class="star-picker__star" data-val="@i" aria-label="@i зірок">★</button>
                    }
                    <input type="hidden" name="stars" id="starsInput" value="5" />
                </div>
            </div>

            <div class="review-form__field">
                <label class="review-form__label">Коментар</label>
                <textarea class="review-form__textarea" name="body"
                          placeholder="Ваші враження від товару..." rows="4" maxlength="1000"></textarea>
            </div>

            <button class="amazon-button amazon-button--primary review-form__submit" type="submit">
                Опублікувати відгук
            </button>
        </form>
    </div>
</section>

@section Scripts {
<script>
(function () {
    let qty = 1;
    const minus    = document.getElementById('qtyMinus');
    const plus     = document.getElementById('qtyPlus');
    const val      = document.getElementById('qtyValue');
    const qtyInput = document.getElementById('qtyInput');

    minus.addEventListener('click', () => { if (qty > 1) { val.textContent = --qty; qtyInput.value = qty; } });
    plus.addEventListener('click',  () => { val.textContent = ++qty; qtyInput.value = qty; });
})();

// ── Star picker ──────────────────────────────────────────────
(function () {
    const picker = document.getElementById('starPicker');
    const input  = document.getElementById('starsInput');
    if (!picker) return;
    const stars  = picker.querySelectorAll('.star-picker__star');
    let selected = 5;

    function paint(upTo) {
        stars.forEach((s, i) => s.classList.toggle('active', i < upTo));
    }
    paint(selected);

    stars.forEach((s, i) => {
        s.addEventListener('mouseenter', () => paint(i + 1));
        s.addEventListener('mouseleave', () => paint(selected));
        s.addEventListener('click', () => {
            selected    = i + 1;
            input.value = selected;
            paint(selected);
        });
    });
})();
</script>
}
