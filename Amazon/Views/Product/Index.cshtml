@using Domain.Entities
@model Amazon.Models.PagedResult<ProductCardViewModel>

@{
    ViewData["Title"] = "Каталог";
    var search       = ViewData["Search"]       as string;
    var categories   = ViewData["Categories"]   as List<Category> ?? new();
    var categoryId   = ViewData["CategoryId"]   as int?;
    var categoryName = ViewData["CategoryName"] as string;
    var currentPage  = (int)(ViewData["Page"] ?? 1);

    bool isSearchMode   = !string.IsNullOrWhiteSpace(search);
    bool isCategoryMode = categoryId.HasValue;
    bool isRootMode     = !isSearchMode && !isCategoryMode;
}

<header class="page-heading">
    <span class="section-heading__eyebrow">Каталог</span>
    @if (isSearchMode)
    {
        <h1>Результати для «@search»</h1>
        @if (Model != null)
        {
            <p class="page-heading__sub">Знайдено: @Model.TotalItems товарів</p>
        }
    }
    else if (isCategoryMode)
    {
        <h1>@categoryName</h1>
        <nav class="catalog-breadcrumb" aria-label="breadcrumb">
            <a asp-action="Index">Каталог</a>
            <span>›</span>
            <span>@categoryName</span>
        </nav>
    }
    else
    {
        <h1>Категорії товарів</h1>
    }
</header>

@{
    var minPrice = ViewData["MinPrice"] as decimal?;
    var maxPrice = ViewData["MaxPrice"] as decimal?;
    var sort     = ViewData["Sort"] as string;
}

@* ── Search + Filters ── *@
<form class="catalog-search-form" asp-action="Index" method="get" id="catalogFilterForm">
    @if (categoryId.HasValue)
    {
        <input type="hidden" name="categoryId" value="@categoryId" />
    }
    @if (search != null)
    {
        <input type="hidden" name="search" value="@search" />
    }

    @if (!isRootMode)
    {
        <div class="catalog-filters">
            <div class="catalog-filters__group">
                <label class="catalog-filters__label">Ціна, ₴</label>
                <div class="catalog-filters__price">
                    <input class="catalog-filters__price-input" type="number" name="minPrice"
                           value="@minPrice" placeholder="від" min="0" />
                    <span>—</span>
                    <input class="catalog-filters__price-input" type="number" name="maxPrice"
                           value="@maxPrice" placeholder="до" min="0" />
                </div>
            </div>
            <div class="catalog-filters__group">
                <label class="catalog-filters__label">Сортування</label>
                <select class="catalog-filters__select" name="sort" onchange="this.form.submit()">
                    @{ var s = sort ?? ""; }
                    <option value=""          selected="@(s == ""           ? "selected" : null)">За назвою</option>
                    <option value="price_asc" selected="@(s == "price_asc"  ? "selected" : null)">Від дешевших</option>
                    <option value="price_desc" selected="@(s == "price_desc" ? "selected" : null)">Від дорогих</option>
                    <option value="newest"    selected="@(s == "newest"     ? "selected" : null)">Новинки</option>
                </select>
            </div>
            <button class="catalog-filters__apply amazon-button amazon-button--secondary" type="submit">
                Застосувати
            </button>
            @if (minPrice.HasValue || maxPrice.HasValue || !string.IsNullOrEmpty(sort))
            {
                <a class="catalog-filters__reset" asp-action="Index"
                   asp-route-categoryId="@categoryId"
                   asp-route-search="@search">Скинути</a>
            }
        </div>
    }
</form>

@* ── Category grid (root mode) ── *@
@if (isRootMode)
{
    <div class="category-grid">
        @foreach (var cat in categories)
        {
            var count = cat.Products?.Count ?? 0;
            <a class="category-card" asp-action="Index" asp-route-categoryId="@cat.Id">
                <div class="category-card__icon">
                    @{
                        var icon = cat.Name switch {
                            "Електроніка"       => "💻",
                            "Телефони"          => "📱",
                            "Аудіо"             => "🎧",
                            "Фото та відео"     => "📷",
                            "Розумний дім"      => "🏠",
                            "Ігри та консолі"   => "🎮",
                            "Аксесуари"         => "🔌",
                            "Побутова техніка"  => "🏷️",
                            "Іграшки"           => "🧸",
                            "Зоотовари"         => "🐾",
                            "Спорт"             => "🏋️",
                            "Книги"             => "📚",
                            "Косметика"         => "💄",
                            "Одяг"              => "👗",
                            "Взуття"            => "👟",
                            "Меблі"             => "🛋️",
                            _                   => "📦"
                        };
                    }
                    @icon
                </div>
                <div class="category-card__info">
                    <span class="category-card__name">@cat.Name</span>
                    <span class="category-card__count">@count товар@(count == 1 ? "" : count is >= 2 and <= 4 ? "и" : "ів")</span>
                </div>
                <svg class="category-card__arrow" viewBox="0 0 20 20" fill="currentColor" width="16" height="16">
                    <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z"/>
                </svg>
            </a>
        }
    </div>
}
else if (Model != null && Model.Items.Count > 0)
{
    @if (isCategoryMode)
    {
        <a class="catalog-back-link" asp-action="Index">← Всі категорії</a>
    }

    <div class="product-grid js-product-grid">
        @foreach (var product in Model.Items)
        {
            <partial name="_ProductCard" model="product" />
        }
    </div>

    <div class="product-grid product-grid--skeleton js-skeleton-grid" aria-hidden="true" style="display:none">
        @for (int i = 0; i < 8; i++)
        {
            <div class="skeleton-card">
                <div class="skeleton skeleton--img"></div>
                <div class="skeleton-card__body">
                    <div class="skeleton skeleton--title"></div>
                    <div class="skeleton skeleton--text"></div>
                    <div class="skeleton skeleton--price"></div>
                    <div class="skeleton skeleton--btn"></div>
                </div>
            </div>
        }
    </div>

    @* ── Pagination ── *@
    @if (Model.TotalPages > 1)
    {
        <nav class="pagination" aria-label="Сторінки">
            @if (Model.HasPrev)
            {
                <a class="pagination__btn" asp-action="Index"
                   asp-route-categoryId="@categoryId"
                   asp-route-search="@search"
                   asp-route-page="@(currentPage - 1)" aria-label="Попередня">
                    ‹
                </a>
            }
            else
            {
                <span class="pagination__btn pagination__btn--disabled">‹</span>
            }

            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                if (p == currentPage)
                {
                    <span class="pagination__num pagination__num--active">@p</span>
                }
                else if (p == 1 || p == Model.TotalPages || Math.Abs(p - currentPage) <= 2)
                {
                    <a class="pagination__num" asp-action="Index"
                       asp-route-categoryId="@categoryId"
                       asp-route-search="@search"
                       asp-route-page="@p">@p</a>
                }
                else if (Math.Abs(p - currentPage) == 3)
                {
                    <span class="pagination__ellipsis">…</span>
                }
            }

            @if (Model.HasNext)
            {
                <a class="pagination__btn" asp-action="Index"
                   asp-route-categoryId="@categoryId"
                   asp-route-search="@search"
                   asp-route-page="@(currentPage + 1)" aria-label="Наступна">
                    ›
                </a>
            }
            else
            {
                <span class="pagination__btn pagination__btn--disabled">›</span>
            }
        </nav>
    }
}
else
{
    @if (isCategoryMode)
    {
        <a class="catalog-back-link" asp-action="Index">← Всі категорії</a>
    }
    <div class="empty-state">
        <span class="empty-state__icon">🔍</span>
        <h2>Нічого не знайдено</h2>
        <p>Спробуйте змінити пошуковий запит або переглянути весь каталог.</p>
        <a class="amazon-button amazon-button--primary" asp-action="Index">Всі категорії</a>
    </div>
}
