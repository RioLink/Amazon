@model IEnumerable<Amazon.Models.CartItemViewModel>

@{
    ViewData["Title"] = "Кошик";
    var items       = Model?.ToList() ?? new List<Amazon.Models.CartItemViewModel>();
    var hasItems    = items.Any();
    var subtotal    = items.Sum(x => x.TotalPrice);
    var totalQty    = items.Sum(x => x.Quantity);
    var shipping    = subtotal >= 500 ? 0m : 99m;
    var total       = subtotal + shipping;
    const decimal FREE_THRESHOLD = 500m;
    var progressPct = hasItems ? (int)Math.Min(100, (subtotal / FREE_THRESHOLD) * 100) : 0;
}

@if (!hasItems)
{
    <div class="empty-state">
        <span class="empty-state__icon">🛒</span>
        <h1>Ваш кошик порожній</h1>
        <p>Додайте товари з каталогу, і вони з'являться тут.</p>
        <a class="amazon-button amazon-button--primary" asp-controller="Product" asp-action="Index">
            Перейти до каталогу
        </a>
    </div>
}
else
{
    <div class="cart-page-layout">

        @* ── Left: items ── *@
        <section class="cart-panel" aria-label="Товари в кошику">
            <div class="cart-panel__header">
                <div>
                    <h1 class="cart-panel__title">Кошик</h1>
                    <span class="cart-panel__count">@totalQty @(totalQty == 1 ? "товар" : totalQty < 5 ? "товари" : "товарів")</span>
                </div>
                <form asp-action="Clear" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="cart-panel__clear">Очистити кошик</button>
                </form>
            </div>

            <ul class="cart-items-list" aria-live="polite">
                @foreach (var item in items)
                {
                    <li class="cart-item">
                        <div class="cart-item__img-wrap">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img class="cart-item__img" src="@item.ImageUrl" alt="@item.ProductName" />
                            }
                            else
                            {
                                <div class="cart-item__image-placeholder">🛍</div>
                            }
                        </div>
                        <div class="cart-item__details">
                            <span class="cart-item__name">@item.ProductName</span>
                            <span class="cart-item__unit-price">@item.Price.ToString("N0") ₴ / шт.</span>
                            <!-- Qty stepper (AJAX) -->
                            <div class="cart-item__stepper" data-product-id="@item.ProductId">
                                <button type="button" class="qty-stepper__btn js-qty-minus" aria-label="Зменшити">−</button>
                                <span class="qty-stepper__value js-qty-val">@item.Quantity</span>
                                <button type="button" class="qty-stepper__btn js-qty-plus" aria-label="Збільшити">+</button>
                            </div>
                        </div>
                        <div class="cart-item__actions">
                            <span class="cart-item__price">@item.TotalPrice.ToString("N0") ₴</span>
                            <form asp-action="Remove" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ProductId" value="@item.ProductId" />
                                <button type="submit" class="cart-item__remove">Видалити</button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        </section>

        @* ── Right: summary ── *@
        <aside class="cart-summary" aria-label="Підсумок замовлення">

            <!-- Free shipping progress -->
            <div class="cart-shipping-progress @(shipping == 0 ? "cart-shipping-progress--achieved" : "")">
                @if (shipping == 0)
                {
                    <p class="cart-shipping-progress__text">🎉 <strong>Безкоштовна доставка!</strong></p>
                }
                else
                {
                    <p class="cart-shipping-progress__text">До безкоштовної: <strong>@((FREE_THRESHOLD - subtotal).ToString("N0")) ₴</strong></p>
                }
                <div class="cart-shipping-progress__bar">
                    <div class="cart-shipping-progress__fill" style="width:@progressPct%"></div>
                </div>
            </div>

            <h2 class="cart-summary__heading">Підсумок</h2>

            <div class="cart-summary__rows">
                <div class="cart-summary__row">
                    <span>Товари (@totalQty)</span>
                    <span>@subtotal.ToString("N0") ₴</span>
                </div>
                <div class="cart-summary__row @(shipping == 0 ? "cart-summary__row--shipping-free" : "")">
                    <span>Доставка</span>
                    <span>@(shipping == 0 ? "Безкоштовно" : shipping.ToString("N0") + " ₴")</span>
                </div>
            </div>

            <hr class="cart-summary__divider" />

            <div class="cart-summary__total">
                <span>Разом</span>
                <span>@total.ToString("N0") ₴</span>
            </div>

            <a class="amazon-button amazon-button--primary cart-summary__checkout-btn"
               asp-controller="Checkout" asp-action="Index">
                Оформити замовлення →
            </a>

            <div class="cart-summary__trust">
                <span>🔒 Безпечна оплата</span>
                <span>↩ Повернення 30 днів</span>
            </div>

            <div class="cart-summary__continue">
                <a asp-controller="Product" asp-action="Index">← Продовжити покупки</a>
            </div>
        </aside>
    </div>
}

@section Scripts {
<script>
(function () {
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
               ?? document.cookie.match(/XSRF-TOKEN=([^;]+)/)?.[1] ?? '';

    async function updateQty(productId, delta, stepperEl) {
        const res = await fetch('/Cart/UpdateQuantity', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({ productId, delta })
        });
        if (!res.ok) return;
        const data = await res.json();

        // Update cart count badge in header
        const badge = document.querySelector('.cart-count');
        if (badge) badge.textContent = data.cartCount;

        // Update displayed qty or remove row
        const valEl = stepperEl.querySelector('.js-qty-val');
        const curQty = parseInt(valEl.textContent);
        const newQty = curQty + delta;

        if (newQty <= 0) {
            // Remove the row and refresh totals
            const li = stepperEl.closest('li.cart-item');
            if (li) li.remove();
            recalcTotals();
            checkEmpty();
        } else {
            valEl.textContent = newQty;
            // Update price cell
            const priceEl = stepperEl.closest('li.cart-item')?.querySelector('.cart-item__price');
            if (priceEl) {
                const unitPriceText = stepperEl.closest('li.cart-item')?.querySelector('.cart-item__unit-price')?.textContent;
                const unitPrice = parseFloat(unitPriceText?.replace(/[^\d.]/g, '') || '0');
                priceEl.textContent = (unitPrice * newQty).toLocaleString('uk-UA') + ' ₴';
            }
            recalcTotals();
        }
    }

    function recalcTotals() {
        const FREE = 500;
        let subtotal = 0;
        document.querySelectorAll('li.cart-item').forEach(li => {
            const priceText = li.querySelector('.cart-item__price')?.textContent ?? '0';
            subtotal += parseFloat(priceText.replace(/[^\d.]/g, '')) || 0;
        });
        const shipping = subtotal >= FREE ? 0 : 99;
        const total    = subtotal + shipping;

        const fmt = n => Math.round(n).toLocaleString('uk-UA') + ' ₴';

        document.querySelectorAll('.cart-summary__row span:last-child')[0]
            && (document.querySelectorAll('.cart-summary__row')[0].querySelector('span:last-child').textContent = fmt(subtotal));
        const shipRow = document.querySelectorAll('.cart-summary__row')[1];
        if (shipRow) shipRow.querySelector('span:last-child').textContent = shipping === 0 ? 'Безкоштовно' : fmt(shipping);
        const totalEl = document.querySelector('.cart-summary__total span:last-child');
        if (totalEl) totalEl.textContent = fmt(total);

        // Update qty count in header
        const totalQty = Array.from(document.querySelectorAll('.js-qty-val'))
            .reduce((sum, el) => sum + parseInt(el.textContent || '0'), 0);
        const countEl = document.querySelector('.cart-panel__count');
        if (countEl) countEl.textContent = totalQty + (totalQty === 1 ? ' товар' : totalQty < 5 ? ' товари' : ' товарів');
    }

    function checkEmpty() {
        if (document.querySelectorAll('li.cart-item').length === 0) {
            location.reload();
        }
    }

    document.querySelectorAll('.cart-item__stepper').forEach(stepper => {
        const productId = parseInt(stepper.dataset.productId);
        stepper.querySelector('.js-qty-minus').addEventListener('click', () => updateQty(productId, -1, stepper));
        stepper.querySelector('.js-qty-plus').addEventListener('click',  () => updateQty(productId,  1, stepper));
    });
})();
</script>
}
