@model IEnumerable<Amazon.Models.CartItemViewModel>

@{
    ViewData["Title"] = "Кошик";
    var hasItems = Model != null && Model.Any();
    var subtotal = hasItems ? Model.Sum(x => x.TotalPrice) : 0;
}

@* Empty state — показываем только если Model пустая *@
<div id="cart-empty-state" class="empty-state" style="@(hasItems ? "display:none;" : "")">
    <span class="empty-state__icon" aria-hidden="true">🛒</span>
    <h1>Ваш кошик порожній</h1>
    <p>Додайте товари з каталогу, і вони з'являться тут.</p>
    <a class="amazon-button amazon-button--primary" asp-controller="Product" asp-action="Index">
        Перейти до каталогу
    </a>
</div>

@* Filled state — показываем только если есть товары *@
<div id="cart-filled-state" class="cart-page-layout" style="@(!hasItems ? "display:none;" : "")">

    <section class="cart-panel" aria-label="Товари в кошику">
        <div class="cart-panel__header">
            <h1>Кошик</h1>
            <form asp-action="Clear" method="post">
                <button type="submit" class="cart-panel__clear">Очистити кошик</button>
            </form>
        </div>
        
        <ul class="cart-items-list" aria-live="polite">
            @if (hasItems)
            {
                @foreach (var item in Model)
                {
                    <li class="cart-item">
                        <div>
                            <strong>@item.ProductName</strong><br />
                            <small>Ціна: @item.Price.ToString("F2") ₴</small>
                        </div>
                        <div>
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <form asp-action="Add" method="post">
                                    <input type="hidden" name="ProductId" value="@item.ProductId" />
                                    <input type="hidden" name="Quantity" value="-1" />
                                    <button type="submit">−</button>
                                </form>

                                <span>@item.Quantity</span>

                                <form asp-action="Add" method="post">

                                    <input type="hidden" name="ProductId" value="@item.ProductId" />
                                    <input type="hidden" name="Quantity" value="1" />
                                    <button type="submit">+</button>
                                </form>
                            </div>
                            <strong>@item.TotalPrice.ToString("F2") ₴</strong>
                            <form asp-action="Remove" method="post">
                                <input type="hidden" name="ProductId" value="@item.ProductId" />
                                <button type="submit" style="color:red; background:none; border:none; cursor:pointer; font-size: 0.8em;">Видалити</button>
                            </form>
                        </div>
                    </li>
                }
            }
        </ul>
    </section>

    <aside class="cart-summary" aria-label="Підсумок замовлення">
        <h2>Підсумок</h2>
        <div class="cart-summary__rows">
            <div class="cart-summary__row">
                <span>Товари</span>
                <span>@subtotal.ToString("F2") ₴</span>
            </div>
            <div class="cart-summary__row">
                <span>Доставка</span>
                <span>0 ₴</span>
            </div>
        </div>

        <hr class="cart-summary__divider" />

        <div class="cart-summary__total">
            <span>Разом</span>
            <span>@subtotal.ToString("F2") ₴</span>
        </div>

        <a class="amazon-button amazon-button--primary cart-summary__checkout-btn" asp-controller="Checkout" asp-action="Index">
            Оформити замовлення →
        </a>
    </aside>
</div>