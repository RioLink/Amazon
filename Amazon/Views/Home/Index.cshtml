@using Domain.Entities
@model IReadOnlyList<ProductCardViewModel>

@{
    ViewData["Title"] = "Головна";
}

<section class="hero" aria-labelledby="hero-title">
    <div class="hero__content">
        <span class="hero__eyebrow">Великі літні знижки</span>
        <h1 id="hero-title">Усе потрібне в одному місці</h1>
        <p>
            Відкривайте популярні товари для дому, роботи й відпочинку.
            Швидка доставка та вигідні пропозиції щодня.
        </p>
        <div class="hero__actions">
            <a class="amazon-button amazon-button--primary"
               asp-controller="Product" asp-action="Index">
                Перейти до каталогу
            </a>
            <a class="hero__secondary-link" href="#categories">Переглянути категорії</a>
        </div>
    </div>

    <div class="hero__visual" aria-hidden="true">
        <div class="hero__circle hero__circle--large"></div>
        <div class="hero__circle hero__circle--small"></div>
        <img src="~/images/hero-shopping.svg" alt="" />
        <span class="hero__discount">до <strong>40%</strong></span>
    </div>
</section>

<section class="home-section" aria-labelledby="popular-title">
    <div class="section-heading">
        <div>
            <span class="section-heading__eyebrow">Обирають покупці</span>
            <h2 id="popular-title">Популярні товари</h2>
        </div>
        <a class="section-heading__link" asp-controller="Product" asp-action="Index">
            Дивитися всі
            <span aria-hidden="true">→</span>
        </a>
    </div>

    <div class="product-grid">
        @foreach (var product in Model)
        {
            <partial name="_ProductCard" model="product" />
        }
    </div>
</section>

@{
    var other = ViewData["OtherProducts"] as List<ProductCardViewModel> ?? new();
}
@if (other.Any())
{
<section class="home-section" aria-labelledby="other-title">
    <div class="section-heading">
        <div>
            <span class="section-heading__eyebrow">Різні категорії</span>
            <h2 id="other-title">Може зацікавити</h2>
        </div>
        <a class="section-heading__link" asp-controller="Product" asp-action="Index">
            Дивитися всі <span aria-hidden="true">→</span>
        </a>
    </div>
    <div class="product-grid">
        @foreach (var product in other)
        {
            <partial name="_ProductCard" model="product" />
        }
    </div>
</section>
}

@{
    var homeCategories = ViewData["Categories"] as List<Domain.Entities.Category> ?? new();
    string CatIcon(string name) => name switch {
        "Електроніка"      => "💻",
        "Телефони"         => "📱",
        "Аудіо"            => "🎧",
        "Фото та відео"    => "📷",
        "Розумний дім"     => "🏠",
        "Ігри та консолі"  => "🎮",
        "Аксесуари"        => "🔌",
        "Побутова техніка" => "🏷️",
        "Іграшки"          => "🧸",
        "Зоотовари"        => "🐾",
        "Спорт"            => "🏋️",
        "Книги"            => "📚",
        "Косметика"        => "💄",
        "Одяг"             => "👗",
        "Взуття"           => "👟",
        "Меблі"            => "🛋️",
        _                  => "📦"
    };
}
<section id="categories" class="home-section" aria-labelledby="categories-title">
    <div class="section-heading">
        <div>
            <span class="section-heading__eyebrow">Знайдіть своє</span>
            <h2 id="categories-title">Категорії товарів</h2>
        </div>
        <a class="section-heading__link" asp-controller="Product" asp-action="Index">
            Всі категорії <span aria-hidden="true">→</span>
        </a>
    </div>

    <div class="category-grid category-grid--home">
        @foreach (var cat in homeCategories)
        {
            var count = cat.Products?.Count ?? 0;
            <a class="category-card"
               asp-controller="Product" asp-action="Index" asp-route-categoryId="@cat.Id">
                <div class="category-card__icon">@CatIcon(cat.Name)</div>
                <div class="category-card__info">
                    <span class="category-card__name">@cat.Name</span>
                    <span class="category-card__count">@count товар@(count == 1 ? "" : count is >= 2 and <= 4 ? "и" : "ів")</span>
                </div>
                <svg class="category-card__arrow" viewBox="0 0 20 20" fill="currentColor" width="14" height="14">
                    <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z"/>
                </svg>
            </a>
        }
    </div>
</section>

<section class="benefits" aria-label="Переваги магазину">
    <article class="benefit">
        <span class="benefit__icon" aria-hidden="true">✓</span>
        <div>
            <h3>Перевірена якість</h3>
            <p>Добірні товари від надійних продавців.</p>
        </div>
    </article>
    <article class="benefit">
        <span class="benefit__icon" aria-hidden="true">→</span>
        <div>
            <h3>Швидка доставка</h3>
            <p>Відправляємо замовлення по всій Україні.</p>
        </div>
    </article>
    <article class="benefit">
        <span class="benefit__icon" aria-hidden="true">↺</span>
        <div>
            <h3>Просте повернення</h3>
            <p>Зручні умови повернення протягом 14 днів.</p>
        </div>
    </article>
</section>
