@using Domain.Entities
@model IEnumerable<Category>

<div class="catalog-menu" id="catalogMenu">
    <button class="catalog-menu__btn" type="button"
            onclick="toggleCatalog()" aria-expanded="false" aria-controls="catalogDropdown">
        <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
            <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        Каталог
    </button>

    <div class="catalog-dropdown" id="catalogDropdown" hidden>
        <ul class="catalog-dropdown__list">
            @foreach (var cat in Model)
            {
                <li>
                    <a class="catalog-dropdown__item"
                       asp-controller="Product" asp-action="Index"
                       asp-route-categoryId="@cat.Id"
                       onclick="closeCatalog()">
                        @cat.Name
                    </a>
                </li>
            }
            <li class="catalog-dropdown__divider"></li>
            <li>
                <a class="catalog-dropdown__item catalog-dropdown__item--all"
                   asp-controller="Product" asp-action="Index"
                   onclick="closeCatalog()">
                    Всі товари →
                </a>
            </li>
        </ul>
    </div>
</div>
