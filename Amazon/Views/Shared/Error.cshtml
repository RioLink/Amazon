@model ErrorViewModel
@{
    ViewData["Title"] = "Помилка сервера";
}

<div class="error-page">
    <div class="error-page__illustration">⚙️</div>
    <div class="error-page__code">500</div>
    <h1 class="error-page__title">Помилка сервера</h1>
    <p class="error-page__sub">Щось пішло не так з нашого боку. Ми вже працюємо над виправленням. Спробуйте повернутися пізніше.</p>
    @if (Model.ShowRequestId)
    {
        <p style="font-size:.75rem;color:#94a3b8;margin-bottom:24px">Request ID: <code>@Model.RequestId</code></p>
    }
    <div class="error-page__actions">
        <a href="/" class="error-page__btn error-page__btn--primary">🏠 На головну</a>
        <a asp-controller="Product" asp-action="Index" class="error-page__btn error-page__btn--secondary">🛍️ Каталог</a>
    </div>
</div>
