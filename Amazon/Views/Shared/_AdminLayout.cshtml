<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Amazon Clone - навчальний інтернет-магазин на ASP.NET Core MVC" />
    <title>@ViewData["Title"] - Amazon Clone</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="main-navigation" aria-label="Головна навігація">
            <div class="category-navigation">
                <div class="category-navigation__content">
                    <a asp-controller="Home" asp-action="Index">Головна</a>
                    <a asp-controller="Admin" asp-action="Index">Товари</a>
                    <a asp-controller="Admin" asp-action="Orders">Замовлення</a>
                </div>
            </div>
        </nav>
    </header>

    <main class="site-main" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-footer__content">
            <a class="site-footer__brand" asp-area="" asp-controller="Home" asp-action="Index">amazon clone</a>
            <nav class="site-footer__links" aria-label="Навігація у підвалі">
                <a href="#">Про нас</a>
                <a href="#">Контакти</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Політика конфіденційності</a>
            </nav>
            <p>&copy; @DateTime.Now.Year Amazon Clone. Навчальний проєкт.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>