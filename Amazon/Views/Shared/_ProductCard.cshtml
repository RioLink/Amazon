@model ProductCardViewModel

<article class="product-card">
    <a class="product-card__image-link" asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id">
        @if (Model.OldPrice.HasValue)
        {
            <span class="product-card__badge">Знижка</span>
        }
        <img class="product-card__image" src="@Model.ImageUrl" alt="@Model.Name" loading="lazy" />
    </a>

    <div class="product-card__content">
        <span class="product-card__category">@Model.Category</span>
        <h3 class="product-card__title">
            <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a>
        </h3>

        <div class="product-card__rating">
            <span>★★★★★</span>
            <small>@Model.Rating (@Model.ReviewCount)</small>
        </div>

        <div class="product-card__footer">
            <div class="product-card__price">
                <strong>@Model.Price.ToString("N0") ₴</strong>
                @if (Model.OldPrice.HasValue)
                {
                    <del>@Model.OldPrice.Value.ToString("N0") ₴</del>
                }
            </div>

            <form asp-controller="Cart" asp-action="Add" method="post">
                <input type="hidden" name="ProductId" value="@Model.Id" />
                <input type="hidden" name="Quantity" value="1" />
                
                <button type="submit" class="product-card__cart-button" aria-label="Додати @Model.Name у кошик">
                    <svg aria-hidden="true" viewBox="0 0 24 24">
                        <path d="M2.5 3.5h2l2.1 10.2a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 1.9-1.4L21 7H6m3 12a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm10 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z" />
                    </svg>
                </button>
            </form>
        </div>
    </div>
</article>