@{
    ViewData["Title"] = "Пароль змінено";
}

<div class="auth-card">
    <div class="auth-confirm-icon auth-confirm-icon--green">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
        </svg>
    </div>
    <div class="auth-card__header">
        <h1 class="auth-card__title">Пароль змінено!</h1>
        <p class="auth-card__subtitle">Ваш пароль успішно оновлено. Тепер можна увійти з новим паролем.</p>
    </div>
    <a asp-action="Login" class="auth-form__submit" style="text-decoration:none;justify-content:center">
        <span>Увійти</span>
        <svg viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/>
        </svg>
    </a>
</div>
