@model LoginViewModel

@{
    ViewData["Title"] = "Вхід";
}

<div class="auth-card">

    <div class="auth-card__header">
        <h1 class="auth-card__title">Вітаємо назад!</h1>
        <p class="auth-card__subtitle">Увійдіть у свій акаунт, щоб продовжити покупки</p>
    </div>

    <form asp-action="Login" method="post" class="auth-form" id="loginForm" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="auth-form__errors"></div>

        <!-- Логін або пошта -->
        <div class="auth-form__group">
            <label asp-for="Username" class="auth-form__label">
                <svg class="auth-form__label-icon" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M3 4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v1.5a.75.75 0 0 1-1.5 0V4a.5.5 0 0 0-.5-.5H5a.5.5 0 0 0-.5.5v12a.5.5 0 0 0 .5.5h10a.5.5 0 0 0 .5-.5v-1.5a.75.75 0 0 1 1.5 0V16a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4Z"/><path d="M10.97 8.22a.75.75 0 0 1 1.06 0l2.25 2.25a.75.75 0 0 1 0 1.06l-2.25 2.25a.75.75 0 1 1-1.06-1.06l.97-.97H6a.75.75 0 0 1 0-1.5h5.94l-.97-.97a.75.75 0 0 1 0-1.06Z"/>
                </svg>
                Логін або пошта
            </label>
            <div class="auth-form__input-wrap">
                <input asp-for="Username" class="auth-form__input" id="loginUsername"
                       placeholder="Введіть логін або email"
                       autocomplete="username"
                       spellcheck="false" />
            </div>
            <span asp-validation-for="Username" class="auth-form__field-error"></span>
        </div>

        <!-- Пароль -->
        <div class="auth-form__group">
            <label asp-for="Password" class="auth-form__label">
                <svg class="auth-form__label-icon" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z" clip-rule="evenodd"/>
                </svg>
                Пароль
            </label>
            <div class="auth-form__input-wrap">
                <input asp-for="Password" class="auth-form__input" id="loginPassword"
                       type="password"
                       placeholder="Введіть пароль"
                       autocomplete="current-password" />
                <button type="button" class="auth-form__eye" onclick="togglePassword('loginPassword', this)" tabindex="-1" aria-label="Показати пароль">
                    <svg class="eye-show" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M10 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/>
                        <path fill-rule="evenodd" d="M.664 10.59a1.651 1.651 0 0 1 0-1.186A10.004 10.004 0 0 1 10 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0 1 10 17c-4.257 0-7.893-2.66-9.336-6.41ZM14 10a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z" clip-rule="evenodd"/>
                    </svg>
                    <svg class="eye-hide" viewBox="0 0 20 20" fill="currentColor" style="display:none">
                        <path fill-rule="evenodd" d="M3.28 2.22a.75.75 0 0 0-1.06 1.06l14.5 14.5a.75.75 0 1 0 1.06-1.06l-1.745-1.745a10.029 10.029 0 0 0 3.3-4.38 1.651 1.651 0 0 0 0-1.185A10.004 10.004 0 0 0 9.999 3a9.956 9.956 0 0 0-4.744 1.194L3.28 2.22ZM7.752 6.69l1.092 1.092a2.5 2.5 0 0 1 3.374 3.373l1.091 1.092a4 4 0 0 0-5.557-5.557Z" clip-rule="evenodd"/>
                        <path d="m10.748 13.93 2.523 2.523a10.015 10.015 0 0 1-3.27.547c-4.258 0-7.894-2.66-9.337-6.41a1.651 1.651 0 0 1 0-1.186A10.007 10.007 0 0 1 2.839 6.02L6.07 9.252a4 4 0 0 0 4.678 4.678Z"/>
                    </svg>
                </button>
            </div>
            <span asp-validation-for="Password" class="auth-form__field-error"></span>
        </div>

        <div class="auth-form__forgot">
            <a asp-action="ForgotPassword" class="auth-form__forgot-link">Забули пароль?</a>
        </div>

        <button type="submit" class="auth-form__submit">
            <span>Увійти</span>
            <svg viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/>
            </svg>
        </button>
    </form>

    <div class="auth-card__divider"><span>або</span></div>

    <div class="auth-card__footer">
        <span>Ще немає акаунту?</span>
        <a asp-controller="Auth" asp-action="Register" class="auth-card__link">
            Зареєструватися безкоштовно →
        </a>
    </div>
</div>

@section Scripts {
<script>
function togglePassword(inputId, btn) {
    const input = document.getElementById(inputId);
    const isPassword = input.type === 'password';
    input.type = isPassword ? 'text' : 'password';
    btn.querySelector('.eye-show').style.display = isPassword ? 'none' : '';
    btn.querySelector('.eye-hide').style.display = isPassword ? '' : 'none';
    btn.setAttribute('aria-label', isPassword ? 'Приховати пароль' : 'Показати пароль');
}

// Live validation highlight
document.getElementById('loginForm').addEventListener('input', function(e) {
    const el = e.target;
    if (!el.classList.contains('auth-form__input')) return;
    if (el.value.trim()) {
        el.classList.remove('input-error');
        el.classList.add('input-ok');
    } else {
        el.classList.remove('input-ok');
    }
}, true);

document.getElementById('loginForm').addEventListener('submit', function(e) {
    let ok = true;
    this.querySelectorAll('.auth-form__input').forEach(el => {
        if (!el.value.trim()) {
            el.classList.add('input-error');
            el.classList.remove('input-ok');
            ok = false;
        }
    });
    if (!ok) e.preventDefault();
});
</script>
}
