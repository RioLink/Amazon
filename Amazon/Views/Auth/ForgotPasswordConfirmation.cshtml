@{
    ViewData["Title"] = "Лист надіслано";
    var email = TempData["ForgotEmail"]?.ToString() ?? "";
}

<div class="auth-card">
    <div class="auth-confirm-icon auth-confirm-icon--success">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
        </svg>
    </div>

    <div class="auth-card__header">
        <h1 class="auth-card__title">Перевірте пошту</h1>
        <p class="auth-card__subtitle">
            @if (!string.IsNullOrEmpty(email))
            {
                <text>Якщо акаунт <b>@email</b> існує — ми надіслали посилання для скидання паролю.</text>
            }
            else
            {
                <text>Якщо акаунт із таким email існує — ми надіслали посилання для скидання паролю.</text>
            }
        </p>
    </div>

    <div class="auth-confirm-note">
        <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z" clip-rule="evenodd"/></svg>
        Посилання дійсне 24 години. Перевірте папку «Спам», якщо лист не прийшов.
    </div>

    <div class="auth-card__footer" style="padding-top:8px">
        <a asp-action="Login" class="auth-card__link">← Повернутися до входу</a>
    </div>
</div>
