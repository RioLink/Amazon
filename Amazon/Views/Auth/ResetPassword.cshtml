@{
    ViewData["Title"] = "Новий пароль";
    var token = ViewData["Token"]?.ToString() ?? "";
    var email = ViewData["Email"]?.ToString() ?? "";
}

<div class="auth-card">
    <div class="auth-card__header">
        <h1 class="auth-card__title">Новий пароль</h1>
        <p class="auth-card__subtitle">Придумайте надійний пароль для <b>@email</b></p>
    </div>

    <form asp-action="ResetPassword" method="post" class="auth-form" id="resetForm" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="token" value="@token" />
        <input type="hidden" name="email" value="@email" />

        <div asp-validation-summary="All" class="auth-form__errors"></div>

        <div class="auth-form__group">
            <label class="auth-form__label">
                <svg class="auth-form__label-icon" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z" clip-rule="evenodd"/>
                </svg>
                Новий пароль
            </label>
            <div class="auth-form__input-wrap">
                <input type="password" name="password" id="resetPw" class="auth-form__input"
                       placeholder="Мінімум 8 символів" autocomplete="new-password"
                       oninput="checkResetStrength(this.value)" />
                <button type="button" class="auth-form__eye" onclick="togglePw('resetPw',this)" tabindex="-1">
                    <svg class="eye-show" viewBox="0 0 20 20" fill="currentColor"><path d="M10 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/><path fill-rule="evenodd" d="M.664 10.59a1.651 1.651 0 0 1 0-1.186A10.004 10.004 0 0 1 10 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0 1 10 17c-4.257 0-7.893-2.66-9.336-6.41ZM14 10a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z" clip-rule="evenodd"/></svg>
                    <svg class="eye-hide" style="display:none" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3.28 2.22a.75.75 0 0 0-1.06 1.06l14.5 14.5a.75.75 0 1 0 1.06-1.06l-1.745-1.745a10.029 10.029 0 0 0 3.3-4.38 1.651 1.651 0 0 0 0-1.185A10.004 10.004 0 0 0 9.999 3a9.956 9.956 0 0 0-4.744 1.194L3.28 2.22ZM7.752 6.69l1.092 1.092a2.5 2.5 0 0 1 3.374 3.373l1.091 1.092a4 4 0 0 0-5.557-5.557Z" clip-rule="evenodd"/><path d="m10.748 13.93 2.523 2.523a10.015 10.015 0 0 1-3.27.547c-4.258 0-7.894-2.66-9.337-6.41a1.651 1.651 0 0 1 0-1.186A10.007 10.007 0 0 1 2.839 6.02L6.07 9.252a4 4 0 0 0 4.678 4.678Z"/></svg>
                </button>
            </div>
            <div class="password-strength" id="resetStrengthWrap" style="display:none">
                <div class="password-strength__bar"><div class="password-strength__fill" id="resetStrengthFill"></div></div>
                <span class="password-strength__label" id="resetStrengthLabel"></span>
            </div>
        </div>

        <div class="auth-form__group">
            <label class="auth-form__label">
                <svg class="auth-form__label-icon" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/>
                </svg>
                Підтвердження
            </label>
            <div class="auth-form__input-wrap">
                <input type="password" name="confirmPassword" id="resetConfirm" class="auth-form__input"
                       placeholder="Повторіть пароль" autocomplete="new-password"
                       oninput="checkResetMatch()" />
                <button type="button" class="auth-form__eye" onclick="togglePw('resetConfirm',this)" tabindex="-1">
                    <svg class="eye-show" viewBox="0 0 20 20" fill="currentColor"><path d="M10 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/><path fill-rule="evenodd" d="M.664 10.59a1.651 1.651 0 0 1 0-1.186A10.004 10.004 0 0 1 10 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0 1 10 17c-4.257 0-7.893-2.66-9.336-6.41ZM14 10a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z" clip-rule="evenodd"/></svg>
                    <svg class="eye-hide" style="display:none" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3.28 2.22a.75.75 0 0 0-1.06 1.06l14.5 14.5a.75.75 0 1 0 1.06-1.06l-1.745-1.745a10.029 10.029 0 0 0 3.3-4.38 1.651 1.651 0 0 0 0-1.185A10.004 10.004 0 0 0 9.999 3a9.956 9.956 0 0 0-4.744 1.194L3.28 2.22ZM7.752 6.69l1.092 1.092a2.5 2.5 0 0 1 3.374 3.373l1.091 1.092a4 4 0 0 0-5.557-5.557Z" clip-rule="evenodd"/><path d="m10.748 13.93 2.523 2.523a10.015 10.015 0 0 1-3.27.547c-4.258 0-7.894-2.66-9.337-6.41a1.651 1.651 0 0 1 0-1.186A10.007 10.007 0 0 1 2.839 6.02L6.07 9.252a4 4 0 0 0 4.678 4.678Z"/></svg>
                </button>
            </div>
            <span class="auth-form__match-hint" id="resetMatchHint"></span>
        </div>

        <button type="submit" class="auth-form__submit">
            <span>Встановити новий пароль</span>
            <svg viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/>
            </svg>
        </button>
    </form>
</div>

@section Scripts {
<script>
function togglePw(id, btn) {
    const el = document.getElementById(id);
    const show = el.type === 'password';
    el.type = show ? 'text' : 'password';
    btn.querySelector('.eye-show').style.display = show ? 'none' : '';
    btn.querySelector('.eye-hide').style.display = show ? '' : 'none';
}
function checkResetStrength(val) {
    const wrap  = document.getElementById('resetStrengthWrap');
    const fill  = document.getElementById('resetStrengthFill');
    const label = document.getElementById('resetStrengthLabel');
    if (!val) { wrap.style.display = 'none'; return; }
    wrap.style.display = 'flex';
    const score = [val.length>=8,/[A-Z]/.test(val),/[a-z]/.test(val),/\d/.test(val),/[^A-Za-z0-9]/.test(val)].filter(Boolean).length;
    const levels = [
        {pct:'20%',cls:'strength-1',txt:'Дуже слабкий'},
        {pct:'40%',cls:'strength-2',txt:'Слабкий'},
        {pct:'60%',cls:'strength-3',txt:'Середній'},
        {pct:'80%',cls:'strength-4',txt:'Сильний'},
        {pct:'100%',cls:'strength-5',txt:'✓ Дуже сильний'},
    ];
    const l = levels[score-1]||levels[0];
    fill.style.width = l.pct; fill.className = 'password-strength__fill '+l.cls;
    label.textContent = l.txt; label.className = 'password-strength__label '+l.cls;
}
function checkResetMatch() {
    const pw = document.getElementById('resetPw').value;
    const cf = document.getElementById('resetConfirm').value;
    const h  = document.getElementById('resetMatchHint');
    if (!cf) { h.textContent=''; return; }
    const ok = pw===cf;
    h.textContent = ok ? '✓ Паролі збігаються' : '✗ Паролі не збігаються';
    h.className   = 'auth-form__match-hint '+(ok?'auth-form__match-hint--ok':'auth-form__match-hint--err');
}
</script>
}
