@{
    ViewData["Title"] = "Відновлення паролю";
}

<div class="auth-card">
    <div class="auth-card__header">
        <h1 class="auth-card__title">Забули пароль?</h1>
        <p class="auth-card__subtitle">Введіть email — надішлемо посилання для скидання</p>
    </div>

    <form asp-action="ForgotPassword" method="post" class="auth-form" id="forgotForm" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="auth-form__errors"></div>

        <div class="auth-form__group">
            <label class="auth-form__label">
                <svg class="auth-form__label-icon" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M3 4a2 2 0 0 0-2 2v1.161l8.441 4.221a1.25 1.25 0 0 0 1.118 0L19 7.162V6a2 2 0 0 0-2-2H3Z"/>
                    <path d="m19 8.839-7.77 3.885a2.75 2.75 0 0 1-2.46 0L1 8.839V14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8.839Z"/>
                </svg>
                Email акаунту
            </label>
            <div class="auth-form__input-wrap">
                <input type="email" name="email" class="auth-form__input"
                       placeholder="your@@email.com"
                       autocomplete="email" autofocus />
            </div>
        </div>

        <button type="submit" class="auth-form__submit">
            <span>Надіслати посилання</span>
            <svg viewBox="0 0 20 20" fill="currentColor">
                <path d="M3.105 2.288a.75.75 0 0 0-.826.95l1.414 4.926A1.5 1.5 0 0 0 5.135 9.25h6.115a.75.75 0 0 1 0 1.5H5.135a1.5 1.5 0 0 0-1.442 1.086l-1.414 4.926a.75.75 0 0 0 .826.95 28.897 28.897 0 0 0 15.293-7.154.75.75 0 0 0 0-1.115A28.897 28.897 0 0 0 3.105 2.288Z"/>
            </svg>
        </button>
    </form>

    <div class="auth-card__divider"><span>або</span></div>
    <div class="auth-card__footer">
        <a asp-action="Login" class="auth-card__link">← Повернутися до входу</a>
    </div>
</div>
