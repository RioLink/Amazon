@model RegisterViewModel

@{
    ViewData["Title"] = "Реєстрація";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card__header">
            <a class="auth-card__brand" asp-controller="Home" asp-action="Index">amazon<span>clone</span></a>
            <h1 class="auth-card__title">Створити акаунт</h1>
        </div>

        <form asp-action="Register" method="post" class="auth-form">
            <div asp-validation-summary="All" class="auth-form__errors"></div>

            <div class="auth-form__group">
                <label asp-for="Username" class="auth-form__label">Логін</label>
                <input asp-for="Username" class="auth-form__input" placeholder="Придумайте логін" autocomplete="username" />
                <span asp-validation-for="Username" class="auth-form__field-error"></span>
            </div>

            <div class="auth-form__group">
                <label asp-for="Password" class="auth-form__label">Пароль</label>
                <input asp-for="Password" class="auth-form__input" type="password" placeholder="Мінімум 8 символів" autocomplete="new-password" />
                <span asp-validation-for="Password" class="auth-form__field-error"></span>
            </div>

            <div class="auth-form__group">
                <label asp-for="ConfirmPassword" class="auth-form__label">Підтвердження паролю</label>
                <input asp-for="ConfirmPassword" class="auth-form__input" type="password" placeholder="Повторіть пароль" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="auth-form__field-error"></span>
            </div>

            <div class="auth-form__hint">
                Пароль має містити: мінімум 8 символів, велику та малу літеру, цифру та спеціальний символ.
            </div>

            <button type="submit" class="auth-form__submit amazon-button amazon-button--primary">
                Зареєструватися
            </button>
        </form>

        <div class="auth-card__footer">
            <span>Вже є акаунт?</span>
            <a asp-controller="Auth" asp-action="Login" class="auth-card__link">Увійти</a>
        </div>
    </div>
</div>
