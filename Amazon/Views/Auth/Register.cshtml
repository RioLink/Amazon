@model RegisterViewModel

@{
    ViewData["Title"] = "Реєстрація";
}

<div class="auth-card">
    <div class="auth-card__header">
        <h1 class="auth-card__title">Створити акаунт</h1>
        <p class="auth-card__subtitle">Приєднуйтесь до мільйонів покупців</p>
    </div>

    <form asp-action="Register" method="post" class="auth-form" id="regForm" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="auth-form__errors"></div>

        <!-- Логін -->
        <div class="auth-form__group">
            <label asp-for="Username" class="auth-form__label">
                <svg class="auth-form__label-icon" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-7 9a7 7 0 1 1 14 0H3Z"/>
                </svg>
                Логін
            </label>
            <div class="auth-form__input-wrap">
                <input asp-for="Username" class="auth-form__input" id="regUsername"
                       placeholder="від 3 символів"
                       autocomplete="username" spellcheck="false"
                       oninput="validateUsername(this)" />
            </div>
            <span asp-validation-for="Username" class="auth-form__field-error"></span>
        </div>

        <!-- Email -->
        <div class="auth-form__group">
            <label asp-for="Email" class="auth-form__label">
                <svg class="auth-form__label-icon" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M3 4a2 2 0 0 0-2 2v1.161l8.441 4.221a1.25 1.25 0 0 0 1.118 0L19 7.162V6a2 2 0 0 0-2-2H3Z"/>
                    <path d="m19 8.839-7.77 3.885a2.75 2.75 0 0 1-2.46 0L1 8.839V14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8.839Z"/>
                </svg>
                Email
            </label>
            <div class="auth-form__input-wrap">
                <input asp-for="Email" class="auth-form__input" id="regEmail"
                       type="email" placeholder="your@@email.com"
                       autocomplete="email" spellcheck="false"
                       oninput="validateEmail(this)" />
            </div>
            <span asp-validation-for="Email" class="auth-form__field-error"></span>
        </div>

        <!-- Пароль -->
        <div class="auth-form__group">
            <label asp-for="Password" class="auth-form__label">
                <svg class="auth-form__label-icon" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z" clip-rule="evenodd"/>
                </svg>
                Пароль
            </label>
            <div class="auth-form__input-wrap">
                <input asp-for="Password" class="auth-form__input" id="regPassword"
                       type="password" placeholder="Мінімум 8 символів"
                       autocomplete="new-password"
                       oninput="checkStrength(this.value); checkMatch();" />
                <button type="button" class="auth-form__eye" onclick="togglePassword('regPassword', this)" tabindex="-1">
                    <svg class="eye-show" viewBox="0 0 20 20" fill="currentColor"><path d="M10 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/><path fill-rule="evenodd" d="M.664 10.59a1.651 1.651 0 0 1 0-1.186A10.004 10.004 0 0 1 10 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0 1 10 17c-4.257 0-7.893-2.66-9.336-6.41ZM14 10a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z" clip-rule="evenodd"/></svg>
                    <svg class="eye-hide" style="display:none" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3.28 2.22a.75.75 0 0 0-1.06 1.06l14.5 14.5a.75.75 0 1 0 1.06-1.06l-1.745-1.745a10.029 10.029 0 0 0 3.3-4.38 1.651 1.651 0 0 0 0-1.185A10.004 10.004 0 0 0 9.999 3a9.956 9.956 0 0 0-4.744 1.194L3.28 2.22ZM7.752 6.69l1.092 1.092a2.5 2.5 0 0 1 3.374 3.373l1.091 1.092a4 4 0 0 0-5.557-5.557Z" clip-rule="evenodd"/><path d="m10.748 13.93 2.523 2.523a10.015 10.015 0 0 1-3.27.547c-4.258 0-7.894-2.66-9.337-6.41a1.651 1.651 0 0 1 0-1.186A10.007 10.007 0 0 1 2.839 6.02L6.07 9.252a4 4 0 0 0 4.678 4.678Z"/></svg>
                </button>
            </div>
            <span asp-validation-for="Password" class="auth-form__field-error"></span>

            <!-- Strength bar -->
            <div class="password-strength" id="strengthWrap" style="display:none">
                <div class="password-strength__bar">
                    <div class="password-strength__fill" id="strengthFill"></div>
                </div>
                <span class="password-strength__label" id="strengthLabel"></span>
            </div>

            <!-- Rules -->
            <ul class="password-rules" id="pwRules">
                <li class="password-rules__item" id="rule-len">
                    <svg viewBox="0 0 16 16" fill="currentColor"><circle cx="8" cy="8" r="7"/></svg>
                    Мін. 8 символів
                </li>
                <li class="password-rules__item" id="rule-upper">
                    <svg viewBox="0 0 16 16" fill="currentColor"><circle cx="8" cy="8" r="7"/></svg>
                    Велика літера (A–Z)
                </li>
                <li class="password-rules__item" id="rule-lower">
                    <svg viewBox="0 0 16 16" fill="currentColor"><circle cx="8" cy="8" r="7"/></svg>
                    Мала літера (a–z)
                </li>
                <li class="password-rules__item" id="rule-digit">
                    <svg viewBox="0 0 16 16" fill="currentColor"><circle cx="8" cy="8" r="7"/></svg>
                    Цифра (0–9)
                </li>
                <li class="password-rules__item" id="rule-special">
                    <svg viewBox="0 0 16 16" fill="currentColor"><circle cx="8" cy="8" r="7"/></svg>
                    Спецсимвол (!@@#$...)
                </li>
            </ul>
        </div>

        <!-- Підтвердження -->
        <div class="auth-form__group">
            <label asp-for="ConfirmPassword" class="auth-form__label">
                <svg class="auth-form__label-icon" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/>
                </svg>
                Підтвердження паролю
            </label>
            <div class="auth-form__input-wrap">
                <input asp-for="ConfirmPassword" class="auth-form__input" id="regConfirm"
                       type="password" placeholder="Повторіть пароль"
                       autocomplete="new-password" oninput="checkMatch()" />
                <button type="button" class="auth-form__eye" onclick="togglePassword('regConfirm', this)" tabindex="-1">
                    <svg class="eye-show" viewBox="0 0 20 20" fill="currentColor"><path d="M10 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/><path fill-rule="evenodd" d="M.664 10.59a1.651 1.651 0 0 1 0-1.186A10.004 10.004 0 0 1 10 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0 1 10 17c-4.257 0-7.893-2.66-9.336-6.41ZM14 10a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z" clip-rule="evenodd"/></svg>
                    <svg class="eye-hide" style="display:none" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3.28 2.22a.75.75 0 0 0-1.06 1.06l14.5 14.5a.75.75 0 1 0 1.06-1.06l-1.745-1.745a10.029 10.029 0 0 0 3.3-4.38 1.651 1.651 0 0 0 0-1.185A10.004 10.004 0 0 0 9.999 3a9.956 9.956 0 0 0-4.744 1.194L3.28 2.22ZM7.752 6.69l1.092 1.092a2.5 2.5 0 0 1 3.374 3.373l1.091 1.092a4 4 0 0 0-5.557-5.557Z" clip-rule="evenodd"/><path d="m10.748 13.93 2.523 2.523a10.015 10.015 0 0 1-3.27.547c-4.258 0-7.894-2.66-9.337-6.41a1.651 1.651 0 0 1 0-1.186A10.007 10.007 0 0 1 2.839 6.02L6.07 9.252a4 4 0 0 0 4.678 4.678Z"/></svg>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="auth-form__field-error"></span>
            <span class="auth-form__match-hint" id="matchHint"></span>
        </div>

        <button type="submit" class="auth-form__submit">
            <span>Зареєструватися</span>
            <svg viewBox="0 0 20 20" fill="currentColor">
                <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z"/>
            </svg>
        </button>
    </form>

    <div class="auth-card__divider"><span>або</span></div>
    <div class="auth-card__footer">
        <span>Вже є акаунт?</span>
        <a asp-controller="Auth" asp-action="Login" class="auth-card__link">Увійти →</a>
    </div>
</div>

@section Scripts {
<script>
function togglePassword(id, btn) {
    const el = document.getElementById(id);
    const show = el.type === 'password';
    el.type = show ? 'text' : 'password';
    btn.querySelector('.eye-show').style.display = show ? 'none' : '';
    btn.querySelector('.eye-hide').style.display = show ? '' : 'none';
}
function validateUsername(el) {
    const val = el.value.trim();
    const ok = val.length >= 3 && /^[a-zA-Z0-9_.\-]+$/.test(val);
    el.classList.toggle('input-ok',    ok && val.length > 0);
    el.classList.toggle('input-error', !ok && val.length > 0);
}
function validateEmail(el) {
    const ok = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(el.value);
    el.classList.toggle('input-ok',    ok);
    el.classList.toggle('input-error', !ok && el.value.length > 0);
}
function checkStrength(val) {
    const wrap  = document.getElementById('strengthWrap');
    const fill  = document.getElementById('strengthFill');
    const label = document.getElementById('strengthLabel');
    if (!val) { wrap.style.display = 'none'; return; }
    wrap.style.display = 'flex';
    const checks = [val.length>=8,/[A-Z]/.test(val),/[a-z]/.test(val),/\d/.test(val),/[^A-Za-z0-9]/.test(val)];
    updateRule('rule-len',     checks[0]);
    updateRule('rule-upper',   checks[1]);
    updateRule('rule-lower',   checks[2]);
    updateRule('rule-digit',   checks[3]);
    updateRule('rule-special', checks[4]);
    const score = checks.filter(Boolean).length;
    const levels = [
        {pct:'20%',cls:'strength-1',txt:'Дуже слабкий'},
        {pct:'40%',cls:'strength-2',txt:'Слабкий'},
        {pct:'60%',cls:'strength-3',txt:'Середній'},
        {pct:'80%',cls:'strength-4',txt:'Сильний'},
        {pct:'100%',cls:'strength-5',txt:'✓ Дуже сильний'},
    ];
    const l = levels[score-1]||levels[0];
    fill.style.width = l.pct; fill.className = 'password-strength__fill '+l.cls;
    label.textContent = l.txt; label.className = 'password-strength__label '+l.cls;
    const pw = document.getElementById('regPassword');
    pw.classList.toggle('input-ok',    score >= 3);
    pw.classList.toggle('input-error', score < 3 && val.length > 0);
}
function updateRule(id, ok) {
    document.getElementById(id)?.classList.toggle('password-rules__item--ok', ok);
}
function checkMatch() {
    const pw  = document.getElementById('regPassword').value;
    const cnf = document.getElementById('regConfirm').value;
    const h   = document.getElementById('matchHint');
    const el  = document.getElementById('regConfirm');
    if (!cnf) { h.textContent = ''; el.classList.remove('input-ok','input-error'); return; }
    const ok = pw === cnf;
    h.textContent = ok ? '✓ Паролі збігаються' : '✗ Паролі не збігаються';
    h.className = 'auth-form__match-hint '+(ok?'auth-form__match-hint--ok':'auth-form__match-hint--err');
    el.classList.toggle('input-ok',    ok);
    el.classList.toggle('input-error', !ok);
}
document.getElementById('regForm').addEventListener('submit', function(e) {
    let ok = true;
    this.querySelectorAll('.auth-form__input').forEach(el => {
        if (!el.value.trim()) { el.classList.add('input-error'); ok = false; }
    });
    const emailEl = document.getElementById('regEmail');
    if (emailEl.value && !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(emailEl.value)) {
        emailEl.classList.add('input-error'); ok = false;
    }
    if (!ok) e.preventDefault();
});
</script>
}
