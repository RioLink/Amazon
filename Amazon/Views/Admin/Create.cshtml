@model Domain.Entities.Product
<h1>Додати товар</h1>
<form asp-action="Create" method="post">
    <div class="form-group"><label>Назва</label><input asp-for="Name" class="form-control" /></div>
    <div class="form-group"><label>Ціна</label><input asp-for="Price" class="form-control" /></div>
    <button type="submit" class="btn btn-success">Створити</button>
</form>