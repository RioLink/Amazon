@model Domain.Entities.Category

@{
    ViewData["Title"] = "Редагування категорії";
    ViewData["ActiveNav"] = "categories";
}

<div class="admin-form-page">
    <div class="admin-form-card">
        <div class="admin-form-card__head">
            <div class="admin-form-card__icon admin-form-card__icon--orange">
                <svg viewBox="0 0 20 20" fill="currentColor">
                    <path d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z"/>
                    <path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z"/>
                </svg>
            </div>
            <div>
                <h1 class="admin-form-card__title">Редагування категорії #@Model.Id</h1>
                <p class="admin-form-card__sub">Товарів у категорії: <strong>@Model.Products.Count</strong></p>
            </div>
        </div>

        <form asp-action="EditCategory" asp-route-id="@Model.Id" method="post" class="admin-form">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div class="admin-alert admin-alert--danger">@error.ErrorMessage</div>
                }
            }

            <div class="admin-form__group">
                <label class="admin-form__label" for="name">Назва категорії</label>
                <input class="admin-form__input" id="name" name="name" type="text"
                       value="@Model.Name" required autofocus />
            </div>

            <div class="admin-form__actions">
                <button type="submit" class="admin-btn admin-btn--primary">
                    <svg viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd"/>
                    </svg>
                    Зберегти зміни
                </button>
                <a asp-action="Categories" class="admin-btn admin-btn--ghost">Скасувати</a>
            </div>
        </form>
    </div>
</div>
