@model IEnumerable<ProductAdminViewModel>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">Управління товарами</h1>
        <a asp-action="Create" class="btn btn-success">Додати товар</a>
    </div>

    <div class="card shadow rounded-4">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>№</th>
                        <th>Назва</th>
                        <th>Ціна</th>
                        <th>Кількість</th>
                        <th class="text-center">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted">@item.Id</td>
                            <td class="fw-semibold">@item.Name</td>
                            <td>@item.Price.ToString("C")</td>
                            <td>@item.Quantity</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-1">Редагувати</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm me-1">Видалити</a>
                                <a asp-action="Detailed" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Детальніше</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>