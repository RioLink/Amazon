@model IEnumerable<ProductAdminViewModel>

@{
    ViewData["Title"] = "Товари";
    ViewData["ActiveNav"] = "products";
}

<div class="admin-topbar">
    <h1 class="admin-topbar__title">Управління товарами</h1>
    <a asp-action="Create" class="amazon-button amazon-button--primary amazon-button--sm">
        + Додати товар
    </a>
</div>

@if (!Model.Any())
{
    <div class="admin-empty">
        <p>Товарів ще немає. Додайте перший!</p>
    </div>
}
else
{
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Назва</th>
                    <th>Ціна</th>
                    <th>Кількість</th>
                    <th>Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="admin-table__id">#@item.Id</td>
                        <td class="admin-table__name">@item.Name</td>
                        <td class="admin-table__price">@item.Price.ToString("N2") ₴</td>
                        <td>
                            <span class="admin-table__qty @(item.Quantity == 0 ? "admin-table__qty--empty" : "")">
                                @item.Quantity шт.
                            </span>
                        </td>
                        <td class="admin-table__actions">
                            <a asp-action="Detailed" asp-route-id="@item.Id" class="admin-btn admin-btn--info">🔍 Деталі</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="admin-btn admin-btn--edit">✏ Змінити</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="admin-btn admin-btn--delete"
                               onclick="return confirm('Видалити товар «@item.Name»?')">🗑 Видалити</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
