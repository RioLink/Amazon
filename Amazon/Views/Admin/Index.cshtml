@model IEnumerable<ProductAdminViewModel>

@{
    ViewData["Title"] = "Товари";
    ViewData["ActiveNav"] = "products";
    var total     = Model.Count();
    var inStock   = Model.Count(p => p.Quantity > 0);
    var outStock  = Model.Count(p => p.Quantity == 0);
    var totalVal  = Model.Sum(p => p.Price * p.Quantity);
}

<!-- Stats cards -->
<div class="admin-stats">
    <div class="admin-stat-card admin-stat-card--blue">
        <div class="admin-stat-card__icon">📦</div>
        <div class="admin-stat-card__body">
            <span class="admin-stat-card__value">@total</span>
            <span class="admin-stat-card__label">Всього товарів</span>
        </div>
    </div>
    <div class="admin-stat-card admin-stat-card--green">
        <div class="admin-stat-card__icon">✅</div>
        <div class="admin-stat-card__body">
            <span class="admin-stat-card__value">@inStock</span>
            <span class="admin-stat-card__label">В наявності</span>
        </div>
    </div>
    <div class="admin-stat-card admin-stat-card--red">
        <div class="admin-stat-card__icon">⚠️</div>
        <div class="admin-stat-card__body">
            <span class="admin-stat-card__value">@outStock</span>
            <span class="admin-stat-card__label">Немає в наявності</span>
        </div>
    </div>
    <div class="admin-stat-card admin-stat-card--orange">
        <div class="admin-stat-card__icon">💰</div>
        <div class="admin-stat-card__body">
            <span class="admin-stat-card__value">@totalVal.ToString("N0") ₴</span>
            <span class="admin-stat-card__label">Вартість складу</span>
        </div>
    </div>
</div>

<!-- Table section -->
<div class="admin-section">
    <div class="admin-section__head">
        <div class="admin-section__head-left">
            <h2 class="admin-section__title">Список товарів</h2>
            <span class="admin-section__count">@total позицій</span>
        </div>
        <a asp-action="Create" class="admin-add-btn">
            <svg viewBox="0 0 20 20" fill="currentColor">
                <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z"/>
            </svg>
            Додати товар
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="admin-empty">
            <div class="admin-empty__icon">📦</div>
            <p class="admin-empty__title">Товарів ще немає</p>
            <p class="admin-empty__sub">Натисніть «Додати товар», щоб почати</p>
            <a asp-action="Create" class="admin-add-btn">+ Додати перший товар</a>
        </div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th class="admin-table__th--id">ID</th>
                        <th>Назва</th>
                        <th>Ціна</th>
                        <th>Кількість</th>
                        <th class="admin-table__th--actions">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="admin-table__row">
                            <td class="admin-table__id">#@item.Id</td>
                            <td>
                                <span class="admin-table__name">@item.Name</span>
                            </td>
                            <td>
                                <span class="admin-table__price">@item.Price.ToString("N2") ₴</span>
                            </td>
                            <td>
                                @if (item.Quantity == 0)
                                {
                                    <span class="admin-badge admin-badge--danger">Немає</span>
                                }
                                else if (item.Quantity <= 5)
                                {
                                    <span class="admin-badge admin-badge--warning">@item.Quantity шт.</span>
                                }
                                else
                                {
                                    <span class="admin-badge admin-badge--success">@item.Quantity шт.</span>
                                }
                            </td>
                            <td class="admin-table__actions">
                                <a asp-action="Detailed" asp-route-id="@item.Id" class="admin-icon-btn admin-icon-btn--view" title="Деталі">
                                    <svg viewBox="0 0 20 20" fill="currentColor">
                                        <path d="M10 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/>
                                        <path fill-rule="evenodd" d="M.664 10.59a1.651 1.651 0 0 1 0-1.186A10.004 10.004 0 0 1 10 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0 1 10 17c-4.257 0-7.893-2.66-9.336-6.41ZM14 10a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z" clip-rule="evenodd"/>
                                    </svg>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="admin-icon-btn admin-icon-btn--edit" title="Редагувати">
                                    <svg viewBox="0 0 20 20" fill="currentColor">
                                        <path d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z"/>
                                        <path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z"/>
                                    </svg>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="admin-icon-btn admin-icon-btn--delete" title="Видалити"
                                   onclick="return confirm('Видалити товар «@item.Name»?')">
                                    <svg viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 0 0 6 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 1 0 .23 1.482l.149-.022.841 10.518A2.75 2.75 0 0 0 7.596 19h4.807a2.75 2.75 0 0 0 2.742-2.53l.841-10.52.149.023a.75.75 0 0 0 .23-1.482A41.03 41.03 0 0 0 14 4.193V3.75A2.75 2.75 0 0 0 11.25 1h-2.5ZM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4ZM8.58 7.72a.75.75 0 0 0-1.5.06l.3 7.5a.75.75 0 1 0 1.5-.06l-.3-7.5Zm4.34.06a.75.75 0 1 0-1.5-.06l-.3 7.5a.75.75 0 1 0 1.5.06l.3-7.5Z" clip-rule="evenodd"/>
                                    </svg>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
