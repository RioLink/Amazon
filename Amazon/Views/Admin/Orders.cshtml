@using Domain.Enums
@model IEnumerable<OrderViewModel>

@{
    ViewData["Title"] = "Замовлення";
    ViewData["ActiveNav"] = "orders";
    var total     = Model.Count();
    var pending   = Model.Count(o => o.Status == OrderStatus.Pending);
    var shipped   = Model.Count(o => o.Status == OrderStatus.Shipped);
    var delivered = Model.Count(o => o.Status == OrderStatus.Delivered);
    var revenue   = Model.Where(o => o.Status != OrderStatus.Cancelled).Sum(o => o.TotalAmount);
}

<!-- Sales chart -->
@{
    var chartLabels = ViewData["ChartLabels"] as string ?? "[]";
    var chartValues = ViewData["ChartValues"] as string ?? "[]";
}
<div class="admin-section" style="margin-bottom:24px">
    <div class="admin-section__head">
        <h2 class="admin-section__title">📈 Виручка за останні 30 днів</h2>
    </div>
    <div style="padding:16px 20px">
        <canvas id="salesChart" height="80"></canvas>
    </div>
</div>

<!-- Stats cards -->
<div class="admin-stats">
    <div class="admin-stat-card admin-stat-card--blue">
        <div class="admin-stat-card__icon">📋</div>
        <div class="admin-stat-card__body">
            <span class="admin-stat-card__value">@total</span>
            <span class="admin-stat-card__label">Всього замовлень</span>
        </div>
    </div>
    <div class="admin-stat-card admin-stat-card--orange">
        <div class="admin-stat-card__icon">⏳</div>
        <div class="admin-stat-card__body">
            <span class="admin-stat-card__value">@pending</span>
            <span class="admin-stat-card__label">Очікують обробки</span>
        </div>
    </div>
    <div class="admin-stat-card admin-stat-card--purple">
        <div class="admin-stat-card__icon">🚚</div>
        <div class="admin-stat-card__body">
            <span class="admin-stat-card__value">@shipped</span>
            <span class="admin-stat-card__label">Відправлено</span>
        </div>
    </div>
    <div class="admin-stat-card admin-stat-card--green">
        <div class="admin-stat-card__icon">💵</div>
        <div class="admin-stat-card__body">
            <span class="admin-stat-card__value">@revenue.ToString("N0") ₴</span>
            <span class="admin-stat-card__label">Виручка</span>
        </div>
    </div>
</div>

<!-- Table section -->
<div class="admin-section">
    <div class="admin-section__head">
        <div class="admin-section__head-left">
            <h2 class="admin-section__title">Список замовлень</h2>
            <span class="admin-section__count">@total замовлень</span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="admin-empty">
            <div class="admin-empty__icon">📋</div>
            <p class="admin-empty__title">Замовлень ще немає</p>
            <p class="admin-empty__sub">Тут з'являться замовлення покупців</p>
        </div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table admin-table--orders">
                <thead>
                    <tr>
                        <th class="admin-table__th--id">ID</th>
                        <th>Дата</th>
                        <th>Покупець</th>
                        <th>Доставка</th>
                        <th>Оплата</th>
                        <th>Сума</th>
                        <th>Статус</th>
                        <th class="admin-table__th--actions">Змінити статус</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr class="admin-table__row">
                            <td class="admin-table__id">#@order.Id</td>
                            <td class="admin-table__date">@order.Date.ToString("dd.MM.yyyy")<br/><small>@order.Date.ToString("HH:mm")</small></td>
                            <td class="admin-table__customer">
                                @if (!string.IsNullOrEmpty(order.FullName))
                                {
                                    <strong>@order.FullName</strong><br/>
                                }
                                @if (!string.IsNullOrEmpty(order.UserEmail))
                                {
                                    <span class="admin-table__sub">@order.UserEmail</span><br/>
                                }
                                @if (!string.IsNullOrEmpty(order.Phone))
                                {
                                    <span class="admin-table__sub">📞 @order.Phone</span>
                                }
                            </td>
                            <td class="admin-table__delivery">
                                @if (!string.IsNullOrEmpty(order.City))
                                {
                                    <span>📍 @order.City</span><br/>
                                }
                                @if (!string.IsNullOrEmpty(order.Address))
                                {
                                    <span class="admin-table__sub">@order.Address</span>
                                }
                                @if (!string.IsNullOrEmpty(order.PostalCode))
                                {
                                    <br/><span class="admin-table__sub">@order.PostalCode</span>
                                }
                            </td>
                            <td class="admin-table__payment">
                                @if (!string.IsNullOrEmpty(order.PaymentMethod))
                                {
                                    @(order.PaymentMethod switch {
                                        "card"    => "💳 Карткою",
                                        "cash"    => "💵 Готівкою",
                                        "digital" => "📱 Apple / Google Pay",
                                        "cod"     => "📦 Накладений платіж",
                                        var m     => m
                                    })
                                }
                            </td>
                            <td><span class="admin-table__price">@order.TotalAmount.ToString("N2") ₴</span></td>
                            <td>
                                @{
                                    var (statusIcon, statusClass, statusText) = order.Status switch {
                                        OrderStatus.Pending    => ("⏳", "pending",    "Очікує"),
                                        OrderStatus.Processing => ("🔄", "processing", "Обробляється"),
                                        OrderStatus.Shipped    => ("🚚", "shipped",    "Відправлено"),
                                        OrderStatus.Delivered  => ("✅", "delivered",  "Доставлено"),
                                        OrderStatus.Cancelled  => ("❌", "cancelled",  "Скасовано"),
                                        _                      => ("",   "",            order.Status.ToString())
                                    };
                                }
                                <span class="admin-order-status admin-order-status--@statusClass">
                                    @statusIcon @statusText
                                </span>
                            </td>
                            <td>
                                <form asp-action="UpdateStatus" method="post" class="admin-status-form">
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <select name="status" class="admin-status-select">
                                        @foreach (OrderStatus s in Enum.GetValues(typeof(OrderStatus)))
                                        {
                                            var label = s switch {
                                                OrderStatus.Pending    => "Очікує",
                                                OrderStatus.Processing => "Обробляється",
                                                OrderStatus.Shipped    => "Відправлено",
                                                OrderStatus.Delivered  => "Доставлено",
                                                OrderStatus.Cancelled  => "Скасовано",
                                                _                      => s.ToString()
                                            };
                                            <option value="@((int)s)" selected="@(s == order.Status)">@label</option>
                                        }
                                    </select>
                                    <button type="submit" class="admin-status-save" title="Зберегти">
                                        <svg viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/>
                                        </svg>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function() {
    const labels = @Html.Raw(chartLabels);
    const values = @Html.Raw(chartValues);
    const ctx = document.getElementById('salesChart').getContext('2d');
    new Chart(ctx, {
        type: 'line',
        data: {
            labels,
            datasets: [{
                label: 'Виручка (₴)',
                data: values,
                borderColor: '#f0a500',
                backgroundColor: 'rgba(240,165,0,0.12)',
                borderWidth: 2,
                pointRadius: 3,
                pointBackgroundColor: '#f0a500',
                tension: 0.35,
                fill: true
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: ctx => ctx.parsed.y.toLocaleString('uk-UA') + ' ₴'
                    }
                }
            },
            scales: {
                x: { ticks: { maxTicksLimit: 10, font: { size: 11 } }, grid: { display: false } },
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: v => v.toLocaleString('uk-UA') + ' ₴',
                        font: { size: 11 }
                    }
                }
            }
        }
    });
})();
</script>
}
