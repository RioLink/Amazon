@using Domain.Enums
@using Domain.Entities
@model IEnumerable<OrderViewModel>

@{
    ViewData["Title"] = "Управління замовленнями";
}

<h1>Список замовлень</h1>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Дата</th>
            <th>Сума</th>
            <th>Статус</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.Date.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@order.TotalAmount.ToString("C")</td>
                <td>
                    <form asp-action="UpdateStatus" method="post" class="form-inline">
                        <input type="hidden" name="id" value="@order.Id" />
                        
                        <div class="input-group">
                            <select name="status" class="form-control form-control-sm"
                                    asp-for="@order.Status"
                                    asp-items="Html.GetEnumSelectList<OrderStatus>()">
                            </select>
                            <div class="input-group-append">
                                <button type="submit" class="btn btn-sm btn-outline-success">✓</button>
                            </div>
                        </div>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>