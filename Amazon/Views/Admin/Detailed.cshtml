@model ProductDetailedViewModel

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">@Model.Name</h1>
        <a asp-action="Index" class="btn btn-secondary">Назад</a>
    </div>

    <div class="card shadow rounded-4">
        <div class="row g-0">

            <div class="col-md-4 d-flex align-items-center justify-content-center p-4">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name"
                         class="img-fluid rounded-3" style="max-height: 300px; object-fit: contain;" />
                }
                else
                {
                    <div class="text-muted">Зображення відсутнє</div>
                }
            </div>

            <div class="col-md-8">
                <div class="card-body p-4">

                    <div class="mb-3">
                        <span class="text-muted small">Категорія</span>
                        <p class="fw-semibold mb-0">@Model.Category</p>
                    </div>

                    <div class="mb-3">
                        <span class="text-muted small">Опис</span>
                        <p class="mb-0">@Model.Description</p>
                    </div>

                    <div class="mb-3">
                        <span class="text-muted small">Ціна</span>
                        <p class="mb-0">@Model.Price.ToString("C")</p>
                    </div>

                    <div class="mb-4">
                        <span class="text-muted small">Кількість</span>
                        <p class="mb-0">@Model.Quantity шт.</p>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id"
                           class="btn btn-warning">Редагувати</a>
                        <a asp-action="Delete" asp-route-id="@Model.Id"
                           class="btn btn-danger">Видалити</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>