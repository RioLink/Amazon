@model ProductDetailedViewModel

@{
    ViewData["Title"] = "Деталі товару";
    ViewData["ActiveNav"] = "products";
}

<div class="admin-topbar">
    <h1 class="admin-topbar__title">Деталі товару #@Model.Id</h1>
    <a asp-action="Index" class="admin-btn admin-btn--back">← Назад до списку</a>
</div>

<div class="admin-detail-card">
    <div class="admin-detail-card__image">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Name" class="admin-detail-card__img" />
        }
        else
        {
            <div class="admin-table__img-placeholder admin-detail-card__no-img">📷<br /><span>Немає фото</span></div>
        }
    </div>

    <div class="admin-detail-card__info">
        <h2 class="admin-detail-card__name">@Model.Name</h2>

        <dl class="admin-detail-card__dl">
            <div class="admin-detail-card__row">
                <dt>Категорія</dt>
                <dd>@Model.Category</dd>
            </div>
            <div class="admin-detail-card__row">
                <dt>Ціна</dt>
                <dd class="admin-table__price">@Model.Price.ToString("N2") ₴</dd>
            </div>
            <div class="admin-detail-card__row">
                <dt>На складі</dt>
                <dd>
                    <span class="admin-table__qty @(Model.Quantity == 0 ? "admin-table__qty--empty" : "")">
                        @Model.Quantity шт.
                    </span>
                </dd>
            </div>
            <div class="admin-detail-card__row admin-detail-card__row--full">
                <dt>Опис</dt>
                <dd>@Model.Description</dd>
            </div>
        </dl>

        <div class="admin-form__actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="admin-btn admin-btn--edit">✏ Редагувати</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="admin-btn admin-btn--delete"
               onclick="return confirm('Видалити товар «@Model.Name»?')">🗑 Видалити</a>
        </div>
    </div>
</div>
