@{
    ViewData["Title"] = "Замовлення підтверджено";
    var orderAddress = ViewData["OrderAddress"]?.ToString() ?? "—";
}

<div class="confirm-page">

    <div class="confirm-hero">
        <div class="confirm-checkmark" aria-hidden="true">✓</div>
        <h1>Замовлення прийнято!</h1>
        <p>Дякуємо за покупку. Ми вже обробляємо ваше замовлення.</p>
    </div>

    <div class="confirm-details">
        <div class="confirm-card">
            <h3>Адреса доставки</h3>
            <p>@orderAddress</p>
        </div>
        <div class="confirm-card">
            <h3>Дата замовлення</h3>
            <p>@DateTime.Now.ToString("dd.MM.yyyy")</p>
            <h3 style="margin-top:16px;">Статус</h3>
            <p><span class="order-status order-status--pending">Очікує обробки</span></p>
        </div>
    </div>

    <div class="confirm-actions">
        <a class="amazon-button amazon-button--primary" asp-controller="Profile" asp-action="Index">
            Мої замовлення
        </a>
        <a class="amazon-button amazon-button--secondary" asp-controller="Product" asp-action="Index">
            Продовжити покупки
        </a>
    </div>

</div>
