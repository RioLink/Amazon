@model List<Amazon.Models.CartItemViewModel>

@{
    ViewData["Title"] = "Оформлення замовлення";
    var subtotal = Model.Sum(i => i.Price * i.Quantity);
    var shipping = subtotal >= 500 ? 0m : 99m;
    var total = subtotal + shipping;
}

<div class="page-heading">
    <span class="section-heading__eyebrow">Оформлення</span>
    <h1>Оформлення замовлення</h1>
    <p>Заповніть дані для доставки та оберіть зручний спосіб оплати.</p>
</div>

<div class="checkout-layout">

    @* ── Left column: form ── *@
    <form asp-action="PlaceOrder" method="post" class="checkout-form-panel" novalidate>
        @Html.AntiForgeryToken()

        @* Step 1 – Delivery *@
        <section class="checkout-section">
            <h2 class="checkout-section__title">
                <span class="checkout-section__num" aria-hidden="true">1</span>
                Дані для доставки
            </h2>

            <div class="form-group">
                <label for="fullName">Повне ім'я *</label>
                <input type="text" id="fullName" name="fullName"
                       placeholder="Іваненко Іван Іванович" autocomplete="name" required />
            </div>

            <div class="form-row form-row--2">
                <div class="form-group">
                    <label for="email">Email *</label>
                    <input type="email" id="email" name="email"
                           placeholder="example@email.com" autocomplete="email" required />
                </div>
                <div class="form-group">
                    <label for="phone">Телефон *</label>
                    <input type="tel" id="phone" name="phone"
                           placeholder="+380 99 999 99 99" autocomplete="tel" required />
                </div>
            </div>

            <div class="form-row form-row--2">
                <div class="form-group">
                    <label for="city">Місто *</label>
                    <input type="text" id="city" name="city"
                           placeholder="Київ" autocomplete="address-level2" required />
                </div>
                <div class="form-group">
                    <label for="postal">Поштовий індекс</label>
                    <input type="text" id="postal" name="postal"
                           placeholder="01001" autocomplete="postal-code" maxlength="10" />
                </div>
            </div>

            <div class="form-group">
                <label for="address">Вулиця, будинок, квартира *</label>
                <input type="text" id="address" name="address"
                       placeholder="вул. Хрещатик, 1, кв. 5" autocomplete="street-address" required />
            </div>
        </section>

        @* Step 2 – Payment *@
        <section class="checkout-section">
            <h2 class="checkout-section__title">
                <span class="checkout-section__num" aria-hidden="true">2</span>
                Спосіб оплати
            </h2>

            <div class="payment-methods" role="radiogroup" aria-label="Оберіть спосіб оплати">
                <div class="payment-method">
                    <input type="radio" id="pay-card" name="payment" value="card" checked />
                    <label for="pay-card">
                        <span class="payment-method__icon" aria-hidden="true">💳</span>
                        Карткою
                    </label>
                </div>
                <div class="payment-method">
                    <input type="radio" id="pay-cash" name="payment" value="cash" />
                    <label for="pay-cash">
                        <span class="payment-method__icon" aria-hidden="true">💵</span>
                        Готівкою
                    </label>
                </div>
                <div class="payment-method">
                    <input type="radio" id="pay-digital" name="payment" value="digital" />
                    <label for="pay-digital">
                        <span class="payment-method__icon" aria-hidden="true">📱</span>
                        Apple / Google Pay
                    </label>
                </div>
            </div>
        </section>

        <button class="amazon-button amazon-button--primary checkout-submit-btn" type="submit">
            Підтвердити замовлення →
        </button>
    </form>

    @* ── Right column: order summary ── *@
    <aside class="checkout-summary" aria-label="Ваше замовлення">
        <h2>Ваше замовлення</h2>

        <ul class="checkout-summary__items">
            @foreach (var item in Model)
            {
                <li class="checkout-summary__item">
                    <span class="checkout-summary__item-name">@item.ProductName <span class="checkout-summary__item-qty">×@item.Quantity</span></span>
                    <span class="checkout-summary__item-price">@((item.Price * item.Quantity).ToString("N0")) ₴</span>
                </li>
            }
        </ul>

        <hr class="checkout-summary__divider" />

        <div class="checkout-summary__rows">
            <div class="checkout-summary__row">
                <span>Товари</span>
                <span>@subtotal.ToString("N0") ₴</span>
            </div>
            <div class="checkout-summary__row">
                <span>Доставка</span>
                <span>@(shipping == 0 ? "Безкоштовно" : $"{shipping:N0} ₴")</span>
            </div>
        </div>

        <div class="checkout-summary__total">
            <span>Разом</span>
            <span>@total.ToString("N0") ₴</span>
        </div>

        <p class="checkout-summary__secure">🔒 Захищена транзакція</p>
    </aside>

</div>
